# Copy to .env.local for development, and add the same keys in Vercel → Settings → Environment Variables.

# Spotify "top track this month" (see SPOTIFY_SETUP.md)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Guest wall (see GUEST_WALL_SETUP.md)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# any long random string; used to hash visitor IPs for rate limiting
IP_HASH_SALT=
# password for /admin
ADMIN_PASSWORD=
